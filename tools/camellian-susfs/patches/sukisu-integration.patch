diff --git a/kernel/extension/cpu_spoof.c b/kernel/extension/cpu_spoof.c
index 0007c2fd..098afaa6 100644
--- a/kernel/extension/cpu_spoof.c
+++ b/kernel/extension/cpu_spoof.c
@@ -1,3 +1,94 @@
+// SukiSU-Ultra: Linux 4.14 (MediaTek camellian) CPU spoof port.
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 4, 0)
+/*
+ * Implemented for real on 4.14 arm64 (all three symbols exist in vmlinux):
+ *   cpu_data[].reg_midr  - per-CPU Main ID Register
+ *   loops_per_jiffy      - BogoMIPS
+ *   elf_hwcap            - ELF hardware capability bitmap
+ * Deliberately NOT faked, because 4.14 simply does not have the mechanism:
+ *   vdso/clocksource.h, enum vdso_clock_mode, VDSO_CLOCKMODE_ARCHTIMER,
+ *   struct vdso_time_data, struct clocksource.vdso_clock_mode,
+ *   the vdso_default symbol, and a 64-bit elf_hwcap2.
+ * 4.14 struct vdso_data (asm/vdso_datapage.h) has no clock_mode field at all.
+ * Reporting "supported" with no writes behind it would be misleading, so the
+ * io handler returns the real result of the writes it can actually perform.
+ */
+#include <linux/kernel.h>
+#include <linux/types.h>
+#include <linux/cpumask.h>
+#include <linux/percpu.h>
+#include <linux/jiffies.h>
+#include <linux/errno.h>
+#include <linux/uaccess.h>
+#include <linux/version.h>
+#include <asm/cpu.h>
+#include <asm/hwcap.h>
+
+static int set_spoof_cpu(const struct ksu_set_spoof_cpu_cmd *cmd)
+{
+    int missing = 0;
+
+    if (!cmd)
+        return -EINVAL;
+    if (cmd->cpu_index >= num_possible_cpus()) {
+        pr_warn("ksu: set_spoof_cpu out-of-bounds cpu_index %u\n", cmd->cpu_index);
+        return -EINVAL;
+    }
+
+    {
+        unsigned long cpu_data_base = find_kernel_symbol_exact("cpu_data");
+        if (cpu_data_base) {
+            struct cpuinfo_arm64 *info = per_cpu_ptr(
+                (struct cpuinfo_arm64 *)cpu_data_base, cmd->cpu_index);
+            if (info)
+                info->reg_midr = cmd->midr;
+            else
+                ++missing;
+        } else {
+            pr_warn("ksu: set_spoof_cpu failed to resolve 'cpu_data'\n");
+            ++missing;
+        }
+    }
+
+    if (cmd->cpu_index == 0) {
+        unsigned long *lpj =
+            (unsigned long *)find_kernel_symbol_exact("loops_per_jiffy");
+        if (lpj)
+            *lpj = ((unsigned long)cmd->bogomips * 500000UL) / (100UL * HZ);
+        else
+            ++missing;
+
+        unsigned long *hwcap =
+            (unsigned long *)find_kernel_symbol_exact("elf_hwcap");
+        if (hwcap)
+            *hwcap = (unsigned long)cmd->hwcap;
+        else
+            ++missing;
+    }
+
+    if (missing) {
+        pr_warn("ksu: set_spoof_cpu for cpu %u incomplete (%d symbol(s) unresolved)\n",
+                cmd->cpu_index, missing);
+        return -ENXIO;
+    }
+
+    pr_info("ksu: CPU %u identity spoofed (MIDR 0x%08x, 4.14 partial: no vDSO/hwcap2 rewrite)\n",
+            cmd->cpu_index, cmd->midr);
+    return 0;
+}
+
+int ksu_extension_cpu_spoof_io(u32 id, void __user *raw)
+{
+    struct ksu_set_spoof_cpu_cmd cmd;
+
+    if (!raw)
+        return -EFAULT;
+    if (copy_from_user(&cmd, raw, sizeof(cmd)))
+        return -EFAULT;
+
+    return set_spoof_cpu(&cmd);
+}
+#else
 // SPDX-License-Identifier: GPL-2.0
 /*
  * CPU spoof extension. io-only: ops = NULL, no sticky enable bit.
@@ -236,3 +327,5 @@ int ksu_extension_cpu_spoof_io(u32 id, void __user *raw)
 
     return set_spoof_cpu(&cmd);
 }
+
+#endif /* SukiSU-Ultra 4.14 GUARD */
